{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["vite", "--host", "--port", "5200", "--strictPort"],
      "port": 5200,
      "autoPort": false
    },
    {
      "name": "preview",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["vite", "preview", "--host", "--port", "4173"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "ui-kit",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["http-server", "ui_kits", "-p", "5300", "-c-1", "--silent"],
      "port": 5300,
      "autoPort": true
    },
    {
      "name": "proto",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["http-server", "public/proto", "-p", "5400", "-c-1", "--silent"],
      "port": 5400,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["storybook", "dev", "-p", "6006", "--no-open", "--ci"],
      "port": 6006,
      "autoPort": false
    }
  ]
}
